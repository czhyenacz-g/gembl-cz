# Universal Content API — content/data vrstva (records/media), viz
# CLAUDE.md. UCA_API_TOKEN je server-only, nikdy se nesmí objevit
# v client bundlu (viz lib/uca/client.ts — "server-only" import).
UCA_BASE_URL=https://content-api.darbujan.com
UCA_PROJECT_SLUG=
UCA_API_TOKEN=

# Steam login — jen pokud projekt features/steam-auth skutečně
# implementuje (viz features/steam-auth/README.md, vyžaduje vlastní DB).
STEAM_API_KEY=
STEAM_RETURN_URL=

# Live stream agregace (features/streams/) — každý provider bez
# nastavených proměnných se sám tiše přeskočí (status "not-configured").
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

YOUTUBE_API_KEY=

# Kick jen pokud je integrace opravdu potřeba — stejný "client credentials"
# vzor jako Twitch (viz features/streams/kick.ts).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Účty + herní kredity G (viz lib/auth/, lib/wallet/). Postgres (Neon přes
# Vercel Marketplace integraci, stejný vzor jako howtofish-cz) — ve
# Vercelu DATABASE_URL doplní integrace automaticky, lokálně stáhni přes
# `vercel env pull .env.local`. Sem se nic ručně nepíše.
DATABASE_URL=

# Podepisuje session cookie (HMAC-SHA256) — libovolný dlouhý náhodný
# řetězec, např. `openssl rand -base64 32`. Nikdy nesdílet mezi projekty.
SESSION_SECRET=

# Odesílání magic-link přihlašovacích e-mailů (Resend, stejná služba jako
# hlasuju-cz). Bez RESEND_API_KEY se magic-link e-mail neodešle a
# přihlášení nebude fungovat.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GEMBL.cz <onboarding@resend.dev>"

# Bázová URL webu — používá se pro magic-link odkazy a Stripe
# success/cancel redirect (viz lib/site-url.ts). Lokálně nech
# http://localhost:3000, v produkci https://www.gembl.cz.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nákup herních kreditů G přes Stripe Checkout (viz lib/wallet/,
# app/api/checkout/, app/api/stripe/webhook/). Publishable key záměrně
# není potřeba — Checkout Session se otevírá server-side redirectem, ne
# Stripe.js na klientovi.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
